# ============================================================
# TransformPDF — Git 忽略规则
# ============================================================

# --- Maven 构建输出 ---
backend/target/

# --- IDE 配置文件 ---
.idea/
*.iml
*.iws
*.ipr

# --- 文件上传目录 (运行时生成) ---
uploads/
backend/uploads/

# --- 系统文件 ---
.DS_Store
Thumbs.db
desktop.ini

# --- Node.js — 前端依赖 ---
frontend/node_modules/
frontend/dist/

# --- 日志文件 ---
*.log
logs/

# --- 环境变量 / 敏感配置 ---
.env
.env.local
.env.*.local

# --- 操作系统临时文件 ---
*.tmp
*.swp
*.swo
*~
